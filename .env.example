# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local import scripts only. Never expose this in browser/client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side food lookup
USDA_FOODDATA_API_KEY=
OPEN_FOOD_FACTS_USER_AGENT=

# Server-side conversational food logging and estimated fallback.
OPENAI_API_KEY=
OPENAI_FOOD_PARSER_MODEL=gpt-5-mini
OPENAI_FOOD_ESTIMATOR_MODEL=gpt-5-mini

# Server-side signing for food confirmation drafts. Use any long random value.
APP_DRAFT_SIGNING_SECRET=

# App behaviour
APP_TIME_ZONE=Europe/London
